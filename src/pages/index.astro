---
import Layout from "../layouts/Layout.astro";
import NavMenu from "../components/NavMenu.astro";
import RevolutionSliderAstro from "../components/RevolutionSliderAstro.astro";
import FormularioContacto from "../components/FormularioContacto.astro";
---

<Layout
	title="Consultora Bis - Business Intelligence Services"
	description="Consultora Bis, tu socio estratégico en Paraguay para el desarrollo y consolidación empresarial. Servicios de asesoramiento financiero, estrategia, investigación y más."
>
	<header class="bg-white text-white p-4 shadow-md sticky top-0 z-50 w-full">
		<div class="container mx-auto flex justify-between items-center">
			<div class="flex items-center">
				<a href="/" class="flex items-center">
					<img
						src="/logo.png"
						alt="Logo Consultora Bis"
						class="h-10 mr-3"
						loading="lazy"
					/>
				</a>
			</div>
			<NavMenu />
		</div>
	</header>
	<RevolutionSliderAstro />
	<main class="flex-grow w-full">
		<section
			class="bg-gradient-to-r from-logo-principal to-logo-secundario text-white py-20 px-4 text-center w-full relative overflow-hidden"
		>
			<div class="container mx-auto relative z-10">
				<h2
					class="text-logo-acento text-4xl md:text-5xl font-extrabold mb-4 animate-fade-in-down md:w-2/3 w-full"
				>
					Brindamos asesoramiento integral con soluciones prácticas y
					orientadas a una gestión empresarial eficiente.
				</h2>
			</div>
			<!-- Imagen de fondo a la derecha -->
			<div
				class="absolute right-0 top-0 bottom-0 w-full md:w-1/3 opacity-20 md:opacity-30 hidden md:block"
			>
				<img
					src="/content/cosultora-bis.png"
					alt=""
					class="w-full h-full object-cover object-left"
					loading="lazy"
				/>
			</div>
		</section>

		<section
			id="quienes-somos"
			class="py-16 px-4 bg-white w-full border-b border-gray-100"
		>
			<div class="container mx-auto max-w-6xl">
				<h2
					class="text-logo-secundario text-3xl font-bold text-center text-blue-800 mb-8"
				>
					Quiénes Somos
				</h2>

				<!-- Slider Container -->
				<div class="relative">
					<!-- Slides -->
					<div class="slider-container overflow-hidden">
						<div
							id="quienes-somos-slider"
							class="slider-wrapper flex transition-transform duration-500 ease-in-out"
						>
							<!-- Slide 1: Consultora Bis -->
							<div
								class="slide w-full flex-shrink-0 px-6 md:px-16 py-6 text-center"
							>
								<h3
									class="text-2xl font-semibold text-logo-secundario mb-3"
								>
									Consultora Bis
								</h3>
								<p class="text-gray-700">
									Somos un equipo multidisciplinario, con
									sólida experiencia en temas de carácter
									económico, financiero, contable y legal,
									comprometidos en brindar servicios de
									asesoramiento empresarial y financiero
									especializado.
								</p>
							</div>

							<!-- Slide 2: Nuestra Misión -->
							<div
								class="slide w-full flex-shrink-0 px-6 md:px-16 py-6 text-center"
							>
								<h3
									class="text-2xl font-semibold text-logo-secundario mb-3"
								>
									Misión
								</h3>
								<p class="text-gray-700">
									Brindar servicios que permitan el <strong
										class="text-logo-secundario"
										>desarrollo y consolidación empresarial</strong
									> de nuestros clientes. Lo hacemos a través de
									un equipo especializado, enfocado en generar <strong
										class="text-logo-secundario"
										>soluciones eficaces e innovadoras</strong
									> que se adapten a tus necesidades.
								</p>
							</div>

							<!-- Slide 3: Nuestra Visión -->
							<div
								class="slide w-full flex-shrink-0 px-6 md:px-16 py-6 text-center"
							>
								<h3
									class="text-2xl font-semibold text-logo-secundario mb-3"
								>
									Visión
								</h3>
								<p class="text-gray-700">
									Convertirnos en <strong
										class="text-logo-secundario"
										>referentes en el ámbito de la
										consultoría</strong
									> en estrategia y gestión empresarial en Paraguay,
									siempre comprometidos con el desarrollo y éxito
									de nuestros clientes.
								</p>
							</div>
						</div>
					</div>

					<!-- Navigation Arrows -->
					<button
						class="slider-prev hidden md:block absolute left-0 top-1/2 -translate-y-1/2 bg-logo-principal hover:bg-logo-secundario text-white p-3 rounded-full transition-colors duration-300 z-10"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-6 w-6"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M15 19l-7-7 7-7"></path>
						</svg>
					</button>
					<button
						class="slider-next hidden md:block absolute right-0 top-1/2 -translate-y-1/2 bg-logo-principal hover:bg-logo-secundario text-white p-3 rounded-full transition-colors duration-300 z-10"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-6 w-6"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M9 5l7 7-7 7"></path>
						</svg>
					</button>

					<!-- Navigation Dots -->
					<div class="flex justify-center mt-8 gap-3">
						<button
							class="slider-dot w-3 h-3 rounded-full bg-logo-principal transition-all duration-300"
							data-slide="0"></button>
						<button
							class="slider-dot w-3 h-3 rounded-full bg-gray-300 hover:bg-logo-acento transition-all duration-300"
							data-slide="1"></button>
						<button
							class="slider-dot w-3 h-3 rounded-full bg-gray-300 hover:bg-logo-acento transition-all duration-300"
							data-slide="2"></button>
					</div>
				</div>
			</div>

			<!-- Slider JavaScript -->
			<script is:inline>
				document.addEventListener("DOMContentLoaded", function () {
					console.log("Quienes Somos slider script loaded");
					const section = document.getElementById("quienes-somos");
					const sliderWrapper = section.querySelector(
						"#quienes-somos-slider",
					);
					const slides = section.querySelectorAll(".slide");
					const prevButton = section.querySelector(".slider-prev");
					const nextButton = section.querySelector(".slider-next");
					const dots = section.querySelectorAll(".slider-dot");

					let autoPlayInterval = null;
					const isMobile = window.innerWidth < 768; // md breakpoint

					console.log("Slider elements:", {
						sliderWrapper,
						slides: slides.length,
						prevButton,
						nextButton,
						dots: dots.length,
					});

					let currentSlide = 0;
					const totalSlides = slides.length;

					function updateSlider() {
						console.log("Updating slider to slide:", currentSlide);
						const translateValue = -(currentSlide * 100);
						sliderWrapper.style.transform = `translateX(${translateValue}%)`;
						console.log(
							"Applied transform:",
							sliderWrapper.style.transform,
						);

						// Update dots
						dots.forEach((dot, index) => {
							if (index === currentSlide) {
								dot.classList.remove("bg-gray-300");
								dot.classList.add("bg-logo-principal");
							} else {
								dot.classList.remove("bg-logo-principal");
								dot.classList.add("bg-gray-300");
							}
						});
					}

					function nextSlide() {
						console.log(
							"Next slide clicked, current:",
							currentSlide,
						);
						currentSlide = (currentSlide + 1) % totalSlides;
						updateSlider();
					}

					function startAutoPlay() {
						if (autoPlayInterval) return; // Ya está corriendo
						console.log("Starting auto-play");
						autoPlayInterval = setInterval(nextSlide, 5000);
					}

					function stopAutoPlay() {
						if (autoPlayInterval) {
							console.log("Stopping auto-play");
							clearInterval(autoPlayInterval);
							autoPlayInterval = null;
						}
					}

					function prevSlide() {
						console.log(
							"Prev slide clicked, current:",
							currentSlide,
						);
						currentSlide =
							(currentSlide - 1 + totalSlides) % totalSlides;
						updateSlider();
					}

					function goToSlide(index) {
						console.log("Go to slide:", index);
						currentSlide = index;
						updateSlider();
					}

					// Event listeners
					if (prevButton) {
						prevButton.addEventListener("click", function () {
							stopAutoPlay(); // Detener auto-play si hace clic en prev
							prevSlide();
						});
						console.log("Prev button listener added");
					}
					if (nextButton) {
						nextButton.addEventListener("click", function () {
							nextSlide();
							if (!isMobile && !autoPlayInterval) {
								startAutoPlay(); // Iniciar auto-play en desktop después del primer clic
							}
						});
						console.log("Next button listener added");
					}

					dots.forEach((dot, index) => {
						dot.addEventListener("click", () => goToSlide(index));
					});
					console.log("Dot listeners added");

					// Auto-play en mobile siempre
					if (isMobile) {
						console.log("Mobile detected - starting auto-play");
						startAutoPlay();
					}
				});
			</script>
		</section>

		<section
			id="servicios"
			class="py-16 px-4 bg-gradient-to-r from-logo-principal to-logo-secundario text-white w-full border-b border-gray-100"
		>
			<div class="container mx-auto max-w-4xl">
				<h2
					class="text-logo-acento text-3xl font-bold text-center mb-10"
				>
					Nuestros Servicios
				</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					<div
						class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300"
					>
						<h3
							class="text-xl font-semibold text-logo-secundario mb-2"
						>
							ASESORAMIENTO FINANCIERO
						</h3>
						<p class="text-gray-700">
							Brindamos servicios especializados en gestión de
							inversiones, wealth management, modelación
							financiera y valoración de empresas. Elaboramos
							planes de negocios y realizamos procesos de due
							diligence para apoyar decisiones estratégicas de
							negocios.
						</p>
					</div>
					<div
						class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300"
					>
						<h3
							class="text-xl font-semibold text-logo-secundario mb-2"
						>
							ASESORAMIENTO LEGAL EMPRESARIAL
						</h3>
						<p class="text-gray-700">
							Brindamos apoyo legal especializado en temas
							vinculados a la actividad empresarial, incluyendo
							constitución de sociedades, redacción y revisión de
							contratos, cumplimiento normativo y gobierno
							corporativo, con una mirada integral que combina lo
							jurídico con lo económico.
						</p>
					</div>
					<div
						class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300"
					>
						<h3
							class="text-xl font-semibold text-logo-secundario mb-2"
						>
							INVESTIGACIÓN
						</h3>
						<p class="text-gray-700">
							Desarrollamos informes detallados que presentan las
							situaciones actuales y las perspectivas de los
							principales sectores económicos, caracterizando las
							tendencias clave y los ciclos económicos.
						</p>
					</div>
					<div
						class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300"
					>
						<h3
							class="text-xl font-semibold text-logo-secundario mb-2"
						>
							ESTUDIOS DE MERCADO
						</h3>
						<p class="text-gray-700">
							Realizamos estudios de mercado que permiten
							comprender la dinámica del sector, el comportamiento
							del consumidor, las tendencias de demanda y la
							competencia, que sirven como base para validar
							desarrollar productos, servicios o definir
							estrategias comerciales.
						</p>
					</div>
					<div
						class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300"
					>
						<h3
							class="text-xl font-semibold text-logo-secundario mb-2"
						>
							ELABORACIÓN Y EVALUACIÓN DE PROYECTOS
						</h3>
						<p class="text-gray-700">
							Brindamos acompañamiento en el diseño, análisis y
							seguimiento de proyectos de inversión, incorporando
							herramientas de evaluación financiera, análisis de
							riesgos y planificación operativa.
						</p>
					</div>
					<div
						class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300"
					>
						<h3
							class="text-xl font-semibold text-logo-secundario mb-2"
						>
							CAPACITACIÓN
						</h3>
						<p class="text-gray-700">
							Diseñamos e impartimos programas de capacitación
							orientados al desarrollo de competencias en el uso
							del software de TICs aplicados a las finanzas, la
							gestión del proyecto y la toma de decisiones
							empresariales.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section
			id="contactanos"
			class="py-16 px-4 bg-white mx-auto max-w-4xl mt-10 mb-10 text-center"
		>
			<h2
				class="text-logo-secundario text-3xl font-bold text-logo-secundario mb-6"
			>
				Contáctanos
			</h2>
			<p class="text-lg text-gray-700 mb-8">
				¿Listo para llevar tu negocio al siguiente nivel? Contáctanos
				hoy mismo para una consulta personalizada.
			</p>
			<div
				class="flex flex-col md:flex-row items-center justify-center space-y-4 md:space-y-0 md:space-x-8"
			>
				<a
					href="https://www.instagram.com/consultorabis/"
					target="_blank"
					class="bg-gradient-to-r from-logo-principal to-logo-secundario hover:bg-logo-acento-darker text-white px-8 py-3 rounded-full text-lg font-semibold transition duration-300 flex items-center"
				>
					<img
						src="icons8-instagram-50.png"
						alt="mail"
						class="w-8 h-8 mr-2"
					/>
					Instagram
				</a>
				<a
					href="https://www.facebook.com/consultoraBis/"
					target="_blank"
					class="bg-gradient-to-r from-logo-principal to-logo-secundario hover:bg-logo-acento-darker text-white px-8 py-3 rounded-full text-lg font-semibold transition duration-300 flex items-center"
				>
					<img
						src="icons8-facebook-50.png"
						alt="phone"
						class="w-8 h-8 mr-2"
					/>
					Facebook
				</a>
			</div>
		</section>

		<section
			id="contacto"
			class="py-16 px-4 bg-gradient-to-r from-logo-principal to-logo-secundario text-white w-full border-b border-gray-100"
		>
			<FormularioContacto />
		</section>

		<section id="maps" class="w-full bg-white">
			<iframe
				width="600"
				height="450"
				style="border: 0"
				loading="lazy"
				allowfullscreen
				referrerpolicy="no-referrer-when-downgrade"
				class="w-full h-[400px] md:h-[500px]"
				title="Mapa de la Consultora Bis"
				src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d901.6694433723138!2d-57.61958063035815!3d-25.315027998602194!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x945da86af6b1b725%3A0xa529b51bbc40b97b!2sAv%20Gral%20M%C3%A1ximo%20Santos%202016%2C%20Asunci%C3%B3n%20001239!5e0!3m2!1ses-419!2spy!4v1765459983384!5m2!1ses-419!2spy"
			></iframe>
		</section>
	</main>

	<footer class="bg-logo-secundario text-white py-8 px-4 mt-auto">
		<div
			class="container mx-auto flex flex-col md:flex-row justify-between items-center text-center md:text-left"
		>
			<p class="mb-4 md:mb-0">
				&copy; {new Date().getFullYear()} Consultora Bis. Todos los derechos
				reservados.
			</p>
			<div class="flex space-x-6">
				<a
					href="https://wa.me/595992097568"
					target="_blank"
					rel="noopener noreferrer"
					class="text-white hover:text-green-400 transition-colors duration-300 flex items-center"
				>
					<img
						src="/icons8-whatsapp.svg"
						alt="WhatsApp"
						class="w-8 h-8 mr-2 icon"
					/> WhatsApp
				</a>
				<a
					href="https://py.linkedin.com/company/consultora-bis"
					target="_blank"
					rel="noopener noreferrer"
					class="text-white hover:text-blue-300 transition-colors duration-300 flex items-center"
				>
					<img
						src="/icons8-linkedin.svg"
						alt="LinkedIn"
						class="w-8 h-8 mr-2 icon"
					/> LinkedIn
				</a>
			</div>
		</div>
	</footer>
</Layout>
