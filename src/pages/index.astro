---
import Layout from "../layouts/Layout.astro";
import NavMenu from "../components/NavMenu.astro";
import RevolutionSliderAstro from "../components/RevolutionSliderAstro.astro";
import FormularioContacto from "../components/FormularioContacto.astro";
---

<Layout
	title="Consultora Bis - Business Intelligence Services"
	description="Consultora Bis, tu socio estratégico en Paraguay para el desarrollo y consolidación empresarial. Servicios de asesoramiento financiero, estrategia, investigación y más."
>
	<header class="bg-white p-4 border-b border-gray-200 sticky top-0 z-50 w-full">
		<div class="container mx-auto flex justify-between items-center">
			<div class="flex items-center">
				<a href="/" class="flex items-center">
					<img
						src="/logo.png"
						alt="Logo Consultora Bis"
						class="h-10 mr-3"
						loading="eager"
					/>
				</a>
			</div>
			<NavMenu />
		</div>
	</header>
	<RevolutionSliderAstro />
	<main class="flex-grow w-full">
		<section
			class="bg-gradient-to-r from-logo-principal to-logo-secundario text-white py-20 px-4 text-center w-full relative overflow-hidden"
		>
			<div class="container mx-auto relative z-10">
				<h2
					class="text-logo-acento text-4xl md:text-5xl font-extrabold mb-4 animate-fade-in-down md:w-2/3 w-full"
				>
					Brindamos asesoramiento integral con soluciones prácticas y
					orientadas a una gestión empresarial eficiente.
				</h2>
			</div>
			<!-- Imagen de fondo a la derecha -->
			<div
				class="absolute right-0 top-0 bottom-0 w-full md:w-1/3 opacity-20 md:opacity-30 hidden md:block"
			>
				<img
					src="/content/cosultora-bis.png"
					alt=""
					class="w-full h-full object-cover object-left"
					loading="lazy"
				/>
			</div>
		</section>

		<section
			id="quienes-somos"
			class="py-16 px-4 bg-white w-full border-b border-gray-100"
		>
			<div class="container mx-auto max-w-6xl">
				<h2 class="text-logo-secundario text-3xl font-bold text-center mb-12">
					Quiénes Somos
				</h2>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8">
					<!-- Consultora Bis -->
					<div class="border-t-2 border-logo-acento pt-6 text-center md:text-left">
						<h3 class="text-2xl font-semibold text-logo-secundario mb-3">
							Consultora Bis
						</h3>
						<p class="text-gray-700">
							Somos un <strong class="text-logo-secundario"
								>equipo multidisciplinario</strong
							>, con sólida experiencia en temas de carácter
							<strong class="text-logo-secundario"
								>económico y financiero</strong
							>. Ayudamos a empresas y particulares a enfrentar
							los desafíos de invertir en proyectos complejos,
							mediante análisis rigurosos, estructuración
							financiera sólida y acompañamiento estratégico en
							la toma de decisiones.
						</p>
					</div>
					<!-- Misión -->
					<div class="border-t-2 border-logo-acento pt-6 text-center md:text-left">
						<h3 class="text-2xl font-semibold text-logo-secundario mb-3">
							Misión
						</h3>
						<p class="text-gray-700">
							Acompañar a empresas y particulares en la
							<strong class="text-logo-secundario"
								>evaluación, estructuración y gestión de
								proyectos de inversión</strong
							>, aportando rigor técnico, análisis financiero
							sólido y soluciones a medida que faciliten
							<strong class="text-logo-secundario"
								>decisiones bien fundamentadas y sostenibles en
								el tiempo</strong
							>.
						</p>
					</div>
					<!-- Visión -->
					<div class="border-t-2 border-logo-acento pt-6 text-center md:text-left">
						<h3 class="text-2xl font-semibold text-logo-secundario mb-3">
							Visión
						</h3>
						<p class="text-gray-700">
							Consolidarnos como una <strong
								class="text-logo-secundario"
								>firma de referencia</strong
							> en asesoramiento económico y financiero,
							destacada por su rigor analítico, independencia de
							criterio y compromiso con la <strong
								class="text-logo-secundario"
								>generación de valor sostenible</strong
							> para nuestros clientes.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section
			id="servicios"
			class="py-16 px-4 bg-gradient-to-r from-logo-principal to-logo-secundario text-white w-full border-b border-gray-100"
		>
			<div class="container mx-auto max-w-6xl">
				<h2 class="text-logo-acento text-3xl font-bold text-center mb-10">
					Nuestros Servicios
				</h2>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
					<!-- Servicio 1 -->
					<div class="bg-white p-6 rounded-lg h-full">
						<h3 class="text-xl font-semibold text-logo-secundario mb-2">
							ASESORAMIENTO FINANCIERO
						</h3>
						<p class="text-gray-700">
							Brindamos servicios especializados en gestión de
							inversiones, wealth management, modelación
							financiera y valoración de empresas. Elaboramos
							planes de negocios y realizamos procesos de due
							diligence para apoyar decisiones estratégicas de
							negocios.
						</p>
					</div>
					<!-- Servicio 2 -->
					<div class="bg-white p-6 rounded-lg h-full">
						<h3 class="text-xl font-semibold text-logo-secundario mb-2">
							ESTUDIOS DE MERCADO
						</h3>
						<p class="text-gray-700">
							Realizamos estudios de mercado que permiten
							comprender la dinámica del sector, el
							comportamiento del consumidor, las tendencias de
							demanda y la competencia, que sirven como base para
							validar desarrollar productos, servicios o definir
							estrategias comerciales.
						</p>
					</div>
					<!-- Servicio 3 -->
					<div class="bg-white p-6 rounded-lg h-full">
						<h3 class="text-xl font-semibold text-logo-secundario mb-2">
							ELABORACIÓN Y EVALUACIÓN DE PROYECTOS
						</h3>
						<p class="text-gray-700">
							Brindamos acompañamiento en el diseño, análisis y
							seguimiento de proyectos de inversión, incorporando
							herramientas de evaluación financiera, análisis de
							riesgos y planificación operativa.
						</p>
					</div>
					<!-- Servicio 4 -->
					<div class="bg-white p-6 rounded-lg h-full">
						<h3 class="text-xl font-semibold text-logo-secundario mb-2">
							CAPACITACIÓN
						</h3>
						<p class="text-gray-700">
							Diseñamos e impartimos programas de capacitación
							orientados al desarrollo de competencias en el uso
							del software de TICs aplicados a las finanzas, la
							gestión del proyecto y la toma de decisiones
							empresariales.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section
			id="contactanos"
			class="py-16 px-4 bg-white mx-auto max-w-4xl mt-10 mb-10 text-center"
		>
			<h2 class="text-logo-secundario text-3xl font-bold mb-6">
				Contáctanos
			</h2>
			<p class="text-lg text-gray-700 mb-8">
				¿Listo para llevar tu negocio al siguiente nivel? Contáctanos
				hoy mismo para una consulta personalizada.
			</p>
			<div
				class="flex flex-col md:flex-row items-center justify-center space-y-4 md:space-y-0 md:space-x-8"
			>
				<a
					href="https://www.instagram.com/consultorabis/"
					target="_blank"
					rel="noopener noreferrer"
					class="bg-gradient-to-r from-logo-principal to-logo-secundario hover:opacity-90 text-white px-8 py-3 rounded-full text-lg font-semibold transition duration-300 flex items-center"
				>
					<img
						src="/icons8-instagram-50.png"
						alt="Instagram"
						class="w-8 h-8 mr-2"
					/>
					Instagram
				</a>
				<a
					href="https://www.facebook.com/consultoraBis/"
					target="_blank"
					rel="noopener noreferrer"
					class="bg-gradient-to-r from-logo-principal to-logo-secundario hover:opacity-90 text-white px-8 py-3 rounded-full text-lg font-semibold transition duration-300 flex items-center"
				>
					<img
						src="/icons8-facebook-50.png"
						alt="Facebook"
						class="w-8 h-8 mr-2"
					/>
					Facebook
				</a>
			</div>
		</section>

		<section
			id="contacto"
			class="py-16 px-4 bg-gradient-to-r from-logo-principal to-logo-secundario text-white w-full border-b border-gray-100"
		>
			<FormularioContacto />
		</section>

		<section id="ubicacion" class="w-full bg-white py-16 px-4">
			<div class="container mx-auto max-w-4xl text-center">
				<h2 class="text-logo-secundario text-3xl font-bold mb-8">
					Dónde Encontrarnos
				</h2>
				<div class="flex flex-col items-center gap-6">
					<div class="flex items-center gap-3">
						<svg
							class="w-7 h-7 text-logo-principal flex-shrink-0"
							fill="currentColor"
							viewBox="0 0 20 20"
						>
							<path
								fill-rule="evenodd"
								d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
								clip-rule="evenodd"></path>
						</svg>
						<p class="text-lg text-gray-700">
							Av. Gral. Máximo Santos N° 2016, Asunción, Paraguay
						</p>
					</div>
					<div class="flex items-center gap-3">
						<svg
							class="w-7 h-7 text-logo-principal flex-shrink-0"
							fill="currentColor"
							viewBox="0 0 20 20"
						>
							<path
								d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"
							></path>
						</svg>
						<a
							href="tel:+595992097568"
							class="text-lg text-gray-700 hover:text-logo-secundario transition-colors duration-300"
							>+595 992 097 568</a
						>
					</div>
				</div>
			</div>
		</section>
	</main>

	<footer class="bg-logo-secundario text-white py-8 px-4 mt-auto">
		<div
			class="container mx-auto flex flex-col md:flex-row justify-between items-center text-center md:text-left"
		>
			<p class="mb-4 md:mb-0">
				&copy; {new Date().getFullYear()} Consultora Bis. Todos los derechos
				reservados.
			</p>
			<div class="flex space-x-6">
				<a
					href="https://wa.me/595992097568"
					target="_blank"
					rel="noopener noreferrer"
					class="text-white hover:text-green-400 transition-colors duration-300 flex items-center"
				>
					<img
						src="/icons8-whatsapp.svg"
						alt="WhatsApp"
						class="w-8 h-8 mr-2 icon"
					/> WhatsApp
				</a>
				<a
					href="https://py.linkedin.com/company/consultora-bis"
					target="_blank"
					rel="noopener noreferrer"
					class="text-white hover:text-blue-300 transition-colors duration-300 flex items-center"
				>
					<img
						src="/icons8-linkedin.svg"
						alt="LinkedIn"
						class="w-8 h-8 mr-2 icon"
					/> LinkedIn
				</a>
			</div>
		</div>
	</footer>
</Layout>
