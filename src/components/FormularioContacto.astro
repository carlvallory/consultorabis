---
// FormularioContacto.astro
// El access key de Web3Forms es público por diseño (viaja desde el cliente).
// Se configura como variable de entorno PUBLIC_WEB3FORMS_KEY en Vercel y en el .env local.
const WEB3FORMS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
---

<section class="text-white py-16 px-4 w-full">
    <div class="container mx-auto max-w-6xl">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
            <!-- Columna Izquierda - Información de Contacto -->
            <div class="space-y-8">
                <h2
                    class="text-logo-acento text-3xl md:text-4xl font-bold mb-8"
                >
                    Obtenga una asesoría<br />personalizada
                </h2>

                <!-- Teléfono -->
                <div class="flex items-start space-x-3">
                    <svg
                        class="w-6 h-6 mt-1 flex-shrink-0"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"
                        ></path>
                    </svg>
                    <div>
                        <h3 class="text-logo-acento text-xl font-semibold mb-1">
                            Teléfono
                        </h3>
                        <a
                            href="tel:+595992097568"
                            class="text-white hover:underline"
                            >+595 992 097 568</a
                        >
                    </div>
                </div>

                <!-- Email -->
                <div class="flex items-start space-x-3">
                    <svg
                        class="w-6 h-6 mt-1 flex-shrink-0"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                        ></path>
                        <path
                            d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
                        ></path>
                    </svg>
                    <div>
                        <h3 class="text-logo-acento text-xl font-semibold mb-1">
                            Email
                        </h3>
                        <a
                            href="mailto:info@consultorabis.com.py"
                            class="text-white hover:underline"
                            >info@consultorabis.com.py</a
                        >
                    </div>
                </div>

                <!-- Dirección -->
                <div class="flex items-start space-x-3">
                    <svg
                        class="w-6 h-6 mt-1 flex-shrink-0"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                            clip-rule="evenodd"></path>
                    </svg>
                    <div>
                        <h3 class="text-logo-acento text-xl font-semibold mb-1">
                            Dirección
                        </h3>
                        <p class="text-white">
                            General Santos N° 2016/Paraguay
                        </p>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha - Formulario -->
            <div class="bg-white rounded-lg p-8">
                <form id="contacto-form" class="space-y-6">
                    <input
                        type="hidden"
                        name="access_key"
                        value={WEB3FORMS_KEY}
                    />
                    <input
                        type="hidden"
                        name="subject"
                        value="Nueva consulta desde el sitio de Consultora Bis"
                    />
                    <input
                        type="hidden"
                        name="from_name"
                        value="Sitio Consultora Bis"
                    />
                    <!-- Honeypot anti-spam: oculto para personas, los bots lo completan -->
                    <input
                        type="checkbox"
                        name="botcheck"
                        class="hidden"
                        style="display:none"
                        tabindex="-1"
                        autocomplete="off"
                    />

                    <!-- Nombre y Apellido -->
                    <div>
                        <label
                            for="nombre"
                            class="block text-gray-700 font-medium mb-2"
                        >
                            Nombre y Apellido
                        </label>
                        <input
                            type="text"
                            id="nombre"
                            name="nombre"
                            placeholder="Joel Peralta"
                            class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent text-gray-900"
                            required
                        />
                    </div>

                    <!-- Celular -->
                    <div>
                        <label
                            for="celular"
                            class="block text-gray-700 font-medium mb-2"
                        >
                            Celular
                        </label>
                        <input
                            type="tel"
                            id="celular"
                            name="celular"
                            placeholder="0982 882 345"
                            class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent text-gray-900"
                            required
                        />
                    </div>

                    <!-- E-mail -->
                    <div>
                        <label
                            for="email"
                            class="block text-gray-700 font-medium mb-2"
                        >
                            E-mail
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="ejemplo@mail.com"
                            class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent text-gray-900"
                            required
                        />
                    </div>

                    <!-- Motivo de Consulta -->
                    <div>
                        <label
                            for="motivo"
                            class="block text-gray-700 font-medium mb-2"
                        >
                            Motivo de Consulta
                        </label>
                        <select
                            id="motivo"
                            name="motivo"
                            class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent text-gray-900"
                            required
                        >
                            <option value="" disabled selected
                                >Selecciona un motivo</option
                            >
                            <option value="asesoramiento-financiero"
                                >Asesoramiento Financiero</option
                            >
                            <option value="estrategia-empresarial"
                                >Estrategia Empresarial</option
                            >
                            <option value="investigacion">Investigación</option>
                            <option value="evaluacion-proyectos"
                                >Evaluación de Proyectos</option
                            >
                            <option value="estudios-mercado"
                                >Estudios de Mercado</option
                            >
                            <option value="capacitacion">Capacitación</option>
                            <option value="otro">Otro</option>
                        </select>
                    </div>

                    <!-- Mensaje -->
                    <div>
                        <label
                            for="mensaje"
                            class="block text-gray-700 font-medium mb-2"
                        >
                            Mensaje
                        </label>
                        <textarea
                            id="mensaje"
                            name="mensaje"
                            rows="4"
                            placeholder="Ingresa aquí tu consulta"
                            class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-teal-600 focus:border-transparent text-gray-900 resize-none"
                            required></textarea>
                    </div>

                    <!-- Botón Enviar -->
                    <div>
                        <button
                            type="submit"
                            class="bg-orange-700 hover:bg-teal-800 text-white font-semibold px-8 py-3 rounded-md transition-colors duration-300 w-full md:w-auto disabled:opacity-60 disabled:cursor-not-allowed"
                        >
                            Enviar
                        </button>
                    </div>

                    <p
                        id="contacto-status"
                        role="status"
                        aria-live="polite"
                        class="hidden text-center font-semibold"
                    >
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("contacto-form");
        if (!form) return;

        const status = document.getElementById("contacto-status");
        const button = form.querySelector('button[type="submit"]');
        const originalLabel = button.textContent.trim();

        const show = (message, ok) => {
            status.textContent = message;
            status.className =
                "text-center font-semibold mt-2 " +
                (ok ? "text-logo-secundario" : "text-red-600");
        };

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            status.classList.add("hidden");
            button.disabled = true;
            button.textContent = "Enviando...";

            try {
                const response = await fetch(
                    "https://api.web3forms.com/submit",
                    {
                        method: "POST",
                        headers: { Accept: "application/json" },
                        body: new FormData(form),
                    },
                );
                const result = await response.json();

                if (response.ok && result.success) {
                    form.reset();
                    show(
                        "¡Gracias! Tu consulta fue enviada. Te contactaremos a la brevedad.",
                        true,
                    );
                } else {
                    throw new Error(result.message || "Error de envío");
                }
            } catch (error) {
                show(
                    "No se pudo enviar tu consulta. Intenta nuevamente o escríbenos a info@consultorabis.com.py.",
                    false,
                );
            } finally {
                button.disabled = false;
                button.textContent = originalLabel;
            }
        });
    });
</script>
