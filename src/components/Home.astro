---
// Home.astro — cuerpo de la página, compartido entre las variantes v1 y v2.
// variant="static" -> secciones en grilla (sin slider)
// variant="slider" -> Servicios en carrusel (Quiénes Somos es un bloque único en ambas)
// hero="nuevo"      -> animación nueva del hero (RevolutionSliderAstro)
// hero="original"   -> réplica del hero del sitio WordPress original (ruta /original)
// hero="combinada"  -> animación original con el alto del hero nuevo (ruta /combinada)
import NavMenu from "./NavMenu.astro";
import RevolutionSliderAstro from "./RevolutionSliderAstro.astro";
import RevolutionSliderOriginal from "./RevolutionSliderOriginal.astro";
import FormularioContacto from "./FormularioContacto.astro";
import QuienesSomos from "./QuienesSomos.astro";
import Servicios from "./Servicios.astro";
import ServiciosSlider from "./legacy/ServiciosSlider.astro";

const { variant = "static", hero = "nuevo" } = Astro.props;
---

<header class="bg-white p-4 border-b border-gray-200 sticky top-0 z-50 w-full">
	<div class="container mx-auto flex justify-between items-center">
		<div class="flex items-center">
			<a href="/" class="flex items-center">
				<img
					src="/logo.png"
					alt="Logo Consultora BIS"
					class="h-10 mr-3"
					loading="eager"
				/>
			</a>
		</div>
		<NavMenu />
	</div>
</header>
{hero === "original" ? (
	<RevolutionSliderOriginal />
) : hero === "combinada" ? (
	<RevolutionSliderOriginal alto="nuevo" />
) : (
	<RevolutionSliderAstro />
)}
<main class="flex-grow w-full">
	<section
		class="bg-gradient-to-r from-logo-principal to-logo-secundario text-white py-20 px-4 text-center w-full relative overflow-hidden"
	>
		<div class="container mx-auto relative z-10">
			<h2
				class="text-logo-acento text-4xl md:text-5xl font-extrabold mb-4 animate-fade-in-down md:w-2/3 w-full"
			>
				Brindamos asesoramiento integral con soluciones prácticas y
				orientadas a una gestión empresarial eficiente.
			</h2>
		</div>
		<!-- Imagen de fondo a la derecha -->
		<div
			class="absolute right-0 top-0 bottom-0 w-full md:w-1/3 opacity-20 md:opacity-30 hidden md:block"
		>
			<img
				src="/content/cosultora-bis.png"
				alt=""
				class="w-full h-full object-cover object-left"
				loading="lazy"
			/>
		</div>
	</section>

	<QuienesSomos />

	{variant === "slider" ? <ServiciosSlider /> : <Servicios />}

	<section
		id="contactanos"
		class="py-16 px-4 bg-white mx-auto max-w-4xl mt-10 mb-10 text-center"
	>
		<h2 class="text-logo-secundario text-3xl font-bold mb-6">
			Contáctanos
		</h2>
		<p class="text-lg text-gray-700 mb-8">
			¿Listo para llevar tu negocio al siguiente nivel? Contáctanos
			hoy mismo para una consulta personalizada.
		</p>
		<div
			class="flex flex-col md:flex-row items-center justify-center space-y-4 md:space-y-0 md:space-x-8"
		>
			<a
				href="https://www.instagram.com/consultorabis/"
				target="_blank"
				rel="noopener noreferrer"
				class="bg-gradient-to-r from-logo-principal to-logo-secundario hover:opacity-90 text-white px-8 py-3 rounded-full text-lg font-semibold transition duration-300 flex items-center"
			>
				<img
					src="/icons8-instagram-50.png"
					alt="Instagram"
					class="w-8 h-8 mr-2"
				/>
				Instagram
			</a>
			<a
				href="https://www.facebook.com/consultoraBis/"
				target="_blank"
				rel="noopener noreferrer"
				class="bg-gradient-to-r from-logo-principal to-logo-secundario hover:opacity-90 text-white px-8 py-3 rounded-full text-lg font-semibold transition duration-300 flex items-center"
			>
				<img
					src="/icons8-facebook-50.png"
					alt="Facebook"
					class="w-8 h-8 mr-2"
				/>
				Facebook
			</a>
			<a
				href="https://lnkd.in/p/dS3vk89E"
				target="_blank"
				rel="noopener noreferrer"
				class="bg-gradient-to-r from-logo-principal to-logo-secundario hover:opacity-90 text-white px-8 py-3 rounded-full text-lg font-semibold transition duration-300 flex items-center"
			>
				<img
					src="/icons8-linkedin.svg"
					alt="LinkedIn"
					class="w-8 h-8 mr-2"
				/>
				LinkedIn
			</a>
		</div>
	</section>

	<section
		id="contacto"
		class="py-16 px-4 bg-gradient-to-r from-logo-principal to-logo-secundario text-white w-full"
	>
		<FormularioContacto />
	</section>
</main>

<footer class="bg-logo-secundario text-white py-8 px-4 mt-auto">
	<div
		class="container mx-auto flex flex-col md:flex-row justify-between items-center text-center md:text-left"
	>
		<p class="mb-4 md:mb-0">
			&copy; {new Date().getFullYear()} Consultora BIS. Todos los derechos
			reservados.
		</p>
		<div class="flex space-x-6">
			<a
				href="https://wa.me/595992097568"
				target="_blank"
				rel="noopener noreferrer"
				class="text-white hover:text-green-400 transition-colors duration-300 flex items-center"
			>
				<img
					src="/icons8-whatsapp.svg"
					alt="WhatsApp"
					class="w-8 h-8 mr-2 icon"
				/> WhatsApp
			</a>
			<a
				href="https://py.linkedin.com/company/consultora-bis"
				target="_blank"
				rel="noopener noreferrer"
				class="text-white hover:text-blue-300 transition-colors duration-300 flex items-center"
			>
				<img
					src="/icons8-linkedin.svg"
					alt="LinkedIn"
					class="w-8 h-8 mr-2 icon"
				/> LinkedIn
			</a>
		</div>
	</div>
</footer>
