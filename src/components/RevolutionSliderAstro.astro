---
// src/components/RevolutionSliderAstro.astro
import { Image } from "astro:assets";
---

<div class="revolution-slider-container">
    <div class="slider-wrapper" id="single-slider-wrapper">
        <div class="slide-background"></div>

        <Image
            src={"/content/corporate-03.png"}
            alt="Corporate Image 1"
            class="slider-layer layer-1"
            width={1408}
            height={174}
            loading="eager"
            densities={[1, 1.5, 2]}
            formats={["webp", "avif", "png"]}
        />

        <Image
            src={"/content/corporate-02.png"}
            alt="Corporate Image 2"
            class="slider-layer layer-2"
            width={1196}
            height={160}
            loading="eager"
            densities={[1, 1.5, 2]}
            formats={["webp", "avif", "png"]}
        />

        <Image
            src={"/content/arrow-black-01.png"}
            alt="Arrow Black"
            class="slider-layer layer-3"
            width={129}
            height={367}
            loading="eager"
            densities={[1, 1.5, 2]}
            formats={["webp", "avif", "png"]}
        />

        <Image
            src={"/content/arrow-red-01.png"}
            alt="Arrow Red"
            class="slider-layer layer-4"
            width={128}
            height={152}
            loading="eager"
            densities={[1, 1.5, 2]}
            formats={["webp", "avif", "png"]}
        />

        <Image
            src={"/content/logo-rows-05.png"}
            alt="Logo Rows"
            class="slider-layer layer-5"
            width={225}
            height={232}
            loading="eager"
            densities={[1, 1.5, 2]}
            formats={["webp", "avif", "png"]}
        />

        <Image
            src={"/content/consultoratexto-06.png"}
            alt="Consultora Texto"
            class="slider-layer layer-6"
            width={632}
            height={142}
            loading="eager"
            densities={[1, 1.5, 2]}
            formats={["webp", "avif", "png"]}
        />
    </div>
</div>

<style>
    .revolution-slider-container {
        position: relative;
        width: 100%;
        max-width: 1920px;
        height: auto;
        /* Aspect ratio más bajo en mobile para evitar que sea demasiado alto */
        aspect-ratio: 16 / 9;
        margin: 0 auto;
        overflow: hidden;
        /* Variables de referencia para los cálculos de GSAP */
        --base-width: 1920px;
        --base-height: 775px;
        /* Altura mínima y máxima para evitar distorsión */
        min-height: 300px;
        max-height: 800px;
    }

    /* En desktop, usar el aspect ratio original */
    @media (min-width: 768px) {
        .revolution-slider-container {
            aspect-ratio: 1920 / 775;
            min-height: 400px;
        }
    }

    .slider-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .slide-background {
        position: absolute;
        width: 100%;
        height: 100%;
        background-color: #ffffff;
        z-index: 1;
    }

    .slider-layer {
        position: absolute;
        opacity: 0;
        z-index: 2;
        transform-origin: center center;
        /* Prevenir distorsión de imágenes */
        object-fit: contain;
        /* Sin image-rendering: crisp-edges — las capas se muestran reducidas
           (p. ej. consultoratexto-06 de 2338px a ~470px) y sin suavizado el
           texto se veía pixelado. El escalado por defecto del navegador es mejor. */
    }

    /* Z-index específicos de Revolution Slider para superposición */
    .layer-1 {
        z-index: 5;
    }
    .layer-2 {
        z-index: 6;
    }
    .layer-3 {
        z-index: 7;
    }
    .layer-4 {
        z-index: 8;
    }
    .layer-5 {
        z-index: 9;
    }
    .layer-6 {
        z-index: 10;
    }
</style>

<script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
        const sliderContainer = document.querySelector(
            ".revolution-slider-container",
        );
        if (!sliderContainer) return;

        // Se obtienen las variables CSS para el tamaño base del diseño
        const baseWidth = parseFloat(
            getComputedStyle(sliderContainer).getPropertyValue("--base-width"),
        );
        const baseHeight = parseFloat(
            getComputedStyle(sliderContainer).getPropertyValue("--base-height"),
        );

        // Función para calcular la posición y tamaño responsivos
        const getResponsiveValue = (value, isWidth) => {
            const currentContainerWidth = sliderContainer.offsetWidth;
            const currentContainerHeight = sliderContainer.offsetHeight;

            if (isWidth) {
                return (value / baseWidth) * currentContainerWidth;
            } else {
                return (value / baseHeight) * currentContainerHeight;
            }
        };

        const animateSlider = () => {
            gsap.killTweensOf(".slider-layer");
            gsap.set(".slider-layer", { opacity: 0 });

            const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

            // Anchos y altos originales de las imágenes para cálculos de superposición/posición
            const layer1OriginalWidth = 1408;
            const layer1OriginalHeight = 174;
            const layer2OriginalWidth = 1196;
            const layer2OriginalHeight = 160;
            const layer3OriginalWidth = 129;
            const layer3OriginalHeight = 367;
            const layer4OriginalWidth = 128;
            const layer4OriginalHeight = 152;
            const layer5OriginalWidth = 225;
            const layer5OriginalHeight = 232;
            const layer6OriginalWidth = 632;
            const layer6OriginalHeight = 142;

            // Coreografía (~3,5 s): cada capa entra mientras la anterior sale,
            // con movimiento continuo hacia arriba (bandas → flecha negra →
            // flecha roja → logo → texto). Entradas con ease-out (frenan al
            // llegar), salidas con ease-in (aceleran al irse). Los tiempos van
            // como posición absoluta en la timeline (3er argumento).

            const getCenteredXPos = (layerWidth) => {
                const currentContainerWidth = sliderContainer.offsetWidth;
                return (
                    currentContainerWidth / 2 -
                    getResponsiveValue(layerWidth, true) / 2
                );
            };

            const getCenteredPos = (layerWidth, layerHeight) => {
                const currentContainerHeight = sliderContainer.offsetHeight;
                return {
                    x: getCenteredXPos(layerWidth),
                    y:
                        currentContainerHeight / 2 -
                        getResponsiveValue(layerHeight, false) / 2,
                };
            };

            const size = (w, h) => ({
                width: getResponsiveValue(w, true),
                height: getResponsiveValue(h, false),
            });

            // --- BANDAS SUPERIORES (corporate-02.png y corporate-03.png) ---
            // Entran desde los costados y frenan al encontrarse.

            const layer2FinalX = -layer2OriginalWidth * 0.1;
            tl.fromTo(
                ".layer-2",
                {
                    x: getResponsiveValue(-layer2OriginalWidth, true),
                    y: 0,
                    ...size(layer2OriginalWidth, layer2OriginalHeight),
                    opacity: 1,
                },
                {
                    x: getResponsiveValue(layer2FinalX, true),
                    duration: 1.2,
                    ease: "expo.out",
                },
                0.1,
            );

            const layer1FinalX = baseWidth - layer1OriginalWidth * 0.9;
            tl.fromTo(
                ".layer-1",
                {
                    x: getResponsiveValue(baseWidth, true),
                    y: 0,
                    ...size(layer1OriginalWidth, layer1OriginalHeight),
                    opacity: 1,
                },
                {
                    x: getResponsiveValue(layer1FinalX, true),
                    duration: 1.2,
                    ease: "expo.out",
                },
                0.1,
            );

            // --- FLECHA NEGRA (arrow-black-01.png) ---
            // Sube desde abajo mientras las bandas terminan de entrar, y a la
            // vez se va desvaneciendo de forma pareja (opacidad 1 → 0,1).

            const layer3X = getCenteredXPos(layer3OriginalWidth);
            const layer3FinalY = getResponsiveValue(
                baseHeight / 1.15 - layer3OriginalHeight,
                false,
            );
            tl.fromTo(
                ".layer-3",
                {
                    x: layer3X,
                    y: getResponsiveValue(baseHeight, false),
                    ...size(layer3OriginalWidth, layer3OriginalHeight),
                    opacity: 1,
                },
                { y: layer3FinalY, duration: 0.8 },
                0.7,
            );
            tl.to(
                ".layer-3",
                { opacity: 0.1, duration: 0.8, ease: "none" },
                0.7,
            );

            // --- FLECHA NEGRA → FLECHA ROJA (arrow-red-01.png) ---
            // La negra sigue subiendo y termina de desaparecer (0,1 → 0); la
            // roja nace a la altura de su punta y completa el movimiento.

            tl.to(
                ".layer-3",
                {
                    y: layer3FinalY - getResponsiveValue(40, false),
                    opacity: 0,
                    duration: 0.4,
                    ease: "power2.in",
                },
                1.6,
            );

            const layer4Pos = getCenteredPos(
                layer4OriginalWidth,
                layer4OriginalHeight,
            );
            tl.fromTo(
                ".layer-4",
                {
                    x: layer4Pos.x,
                    y: layer4Pos.y + getResponsiveValue(40, false),
                    ...size(layer4OriginalWidth, layer4OriginalHeight),
                    opacity: 0,
                },
                { y: layer4Pos.y, opacity: 1, duration: 0.5 },
                1.5, // justo cuando la flecha negra llega a 0,1
            );

            // --- FLECHA ROJA → LOGO (logo-rows-05.png) ---
            // El logo arranca al tamaño de la flecha roja (escala 0,55) y crece
            // hasta su tamaño final, como si la flecha "se desplegara".

            tl.to(
                ".layer-4",
                {
                    y: layer4Pos.y - getResponsiveValue(15, false),
                    opacity: 0,
                    duration: 0.3,
                    ease: "power2.in",
                },
                2.25,
            );

            const layer5Pos = getCenteredPos(
                layer5OriginalWidth,
                layer5OriginalHeight,
            );
            tl.fromTo(
                ".layer-5",
                {
                    x: layer5Pos.x,
                    y: layer5Pos.y + getResponsiveValue(10, false),
                    ...size(layer5OriginalWidth, layer5OriginalHeight),
                    scale: 0.55,
                    opacity: 0,
                },
                {
                    y: layer5Pos.y,
                    scale: 1,
                    opacity: 1,
                    duration: 0.7,
                    ease: "back.out(1.4)",
                },
                2.2,
            );

            // --- TEXTO (consultoratexto-06.png) ---
            // Entra deslizándose levemente desde abajo cuando el logo se asienta.

            const layer6FinalY = getResponsiveValue(
                baseHeight - layer6OriginalHeight * 1.5,
                false,
            );
            tl.fromTo(
                ".layer-6",
                {
                    x: getCenteredXPos(layer6OriginalWidth),
                    y: layer6FinalY + getResponsiveValue(25, false),
                    ...size(layer6OriginalWidth, layer6OriginalHeight),
                    opacity: 0,
                },
                { y: layer6FinalY, opacity: 1, duration: 0.7 },
                2.7,
            );

            // Respeta la preferencia de movimiento reducido: salta al estado
            // final (composición completa) sin reproducir la animación.
            if (
                window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ) {
                tl.progress(1);
            }
        };

        // Recalcular posiciones en resize
        let resizeTimer;
        window.addEventListener("resize", () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
                animateSlider();
            }, 250);
        });

        // Ejecutar la animación al cargar
        animateSlider();
    });
</script>
