# Web3Forms — manejo del formulario de contacto
# Obtené un access key gratuito en https://web3forms.com registrándolo
# con el correo que debe RECIBIR las consultas (info@consultorabis.com.py).
# El prefijo PUBLIC_ es requerido por Astro para exponerlo al cliente;
# este access key es público por diseño, no es un secreto.
PUBLIC_WEB3FORMS_KEY=tu-access-key-aqui
